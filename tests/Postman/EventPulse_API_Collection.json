{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-1234567890ab",
    "name": "EventPulse API Test Suite",
    "description": "Automated Network API Integration Test Collection for EventPulse STLC Quality Gates.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ticket Holds",
      "item": [
        {
          "name": "POST /api/orders/hold - Success (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response structure and values are correct', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('holdId');",
                  "    pm.expect(jsonData.holdId).to.match(/^HOLD-/);",
                  "    pm.expect(jsonData.quantity).to.eql(2);",
                  "    pm.expect(jsonData.subtotal).to.eql(100.00);",
                  "    pm.expect(jsonData).to.have.property('expirationTimestamp');",
                  "    pm.environment.set('lastHoldId', jsonData.holdId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": 1,\n  \"ticketTypeId\": \"GA\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/hold",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "hold"]
            }
          }
        },
        {
          "name": "POST /api/orders/hold - Exceed Limit (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message matches 4-ticket limit policy', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.include('Maximum 4 tickets allowed per order.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": 1,\n  \"ticketTypeId\": \"GA\",\n  \"quantity\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/hold",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "hold"]
            }
          }
        }
      ]
    }
  ]
}